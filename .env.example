# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional server-side session signing secret (auto-derived if omitted)
SESSION_SECRET=""

# Optional Google OAuth Client ID for Google Identity Services Sign-In
GOOGLE_CLIENT_ID=""

# Optional Stripe Billing configuration for live PRO checkout
STRIPE_SECRET_KEY=""
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_PRO_YEARLY_PRICE_ID=""
